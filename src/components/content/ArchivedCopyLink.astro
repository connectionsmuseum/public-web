---
const siteOrigin = Astro.site?.origin ?? "https://connections.museum";
---

<!-- For missing pages, use the current path on the public site, including its
     query but excluding its fragment. Local previews must not send Wayback to
     localhost. Without JavaScript the link still opens the site's archive. -->
<a data-archived-copy data-archive-origin={siteOrigin} href={`https://web.archive.org/web/*/${siteOrigin}/`}>Look for an archived copy</a>

<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-archived-copy]").forEach((link) => {
    const original = new URL(link.dataset.archiveOrigin!);
    original.pathname = window.location.pathname;
    original.search = window.location.search;
    link.href = `https://web.archive.org/web/*/${original.href}`;
  });
</script>
