---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  /** Imported image from the images/ directory so Astro can optimize it. */
  image: ImageMetadata;
  /** Concise independent description; use an empty string only when decorative. */
  alt: string;
}

const { image, alt } = Astro.props;
const bannerSizes =
  "(max-width: 799px) calc(100vw - 36px), (max-width: 1672px) calc(100vw - 72px), 1600px";
---

<!-- Alt text describes the image independently. The visible caption adds
     context or attribution; it is not a substitute for non-empty alt text. -->

<figure class="banner-figure">
  <Image
    class="banner"
    src={image}
    alt={alt}
    widths={[640, 960, 1280, 1600]}
    sizes={bannerSizes}
    format="webp"
    quality={95}
    loading="eager"
    fetchpriority="high"
  />
  <figcaption><i><slot /></i></figcaption>
</figure>

<style>
  .banner-figure {
    width: 100%;
    min-width: 0;
    margin: 0;
  }

  .banner {
    display: block;
    width: 100%;
    max-width: 100%;
    max-height: 600px;
    height: auto;
    object-fit: cover;
  }

  .banner-figure figcaption {
    margin-top: 0.5rem;
  }
</style>
