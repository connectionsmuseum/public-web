---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { responsiveImageWidths } from "../../lib/responsive-image.mjs";

interface Props {
  /** Imported image from images/ so Astro can emit an optimized srcset. */
  image: ImageMetadata;
  /** Alternative text; use an empty string for decorative images. */
  alt: string;
  /** Browser loading priority for non-hero images. */
  loading?: "eager" | "lazy";
  /** Fetch priority; defaults to high for eager images. */
  fetchPriority?: "high" | "low" | "auto";
  /** CSS sizes expression matching the rendered layout. */
  sizes?: string;
  /** Reserves the shared banner ratio when the figure is a hero/banner. */
  aspectRatio?: "banner" | "regular";
}

const {
  image,
  alt,
  loading = "lazy",
  fetchPriority = loading === "eager" ? "high" : "auto",
  sizes = "(max-width: 600px) 100vw, 33vw",
  aspectRatio = "regular",
} = Astro.props;
const hasCaption = Astro.slots.has("default");
const ratioClass = aspectRatio === "banner" ? "media-figure--banner" : "";
---

<figure class:list={["media-figure", ratioClass]}>
  <Image
    src={image}
    alt={alt}
    widths={responsiveImageWidths}
    sizes={sizes}
    format="webp"
    quality={95}
    loading={loading}
    fetchpriority={fetchPriority}
  />
  {hasCaption && <figcaption><slot /></figcaption>}
</figure>

<style>
  .media-figure {
    width: 100%;
    max-width: 100%;
    margin: 0;
  }

  .media-figure img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
  }

  .media-figure--banner img {
    aspect-ratio: var(--banner-aspect-ratio);
    object-fit: cover;
  }

  .media-figure figcaption {
    margin-top: 0.5rem;
  }
</style>
