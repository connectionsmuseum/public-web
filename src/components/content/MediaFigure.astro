---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  /** Imported image from images/ so Astro can emit an optimized srcset. */
  image: ImageMetadata;
  /** Alternative text; use an empty string for decorative images. */
  alt: string;
  /** Browser loading priority for non-hero images. */
  loading?: "eager" | "lazy";
  /** Fetch priority; defaults to high for eager images. */
  fetchPriority?: "high" | "low" | "auto";
  /** CSS sizes expression matching the rendered layout. */
  sizes?: string;
}

const {
  image,
  alt,
  loading = "lazy",
  fetchPriority = loading === "eager" ? "high" : "auto",
  sizes = "(max-width: 600px) 100vw, 33vw",
} = Astro.props;
const hasCaption = Astro.slots.has("default");
---

<figure class="media-figure">
  <Image
    src={image}
    alt={alt}
    widths={[480, 800, 1200]}
    sizes={sizes}
    format="webp"
    quality={95}
    loading={loading}
    fetchpriority={fetchPriority}
  />
  {hasCaption && <figcaption><slot /></figcaption>}
</figure>

<style>
  .media-figure {
    width: 100%;
    max-width: 100%;
    margin: 0;
  }

  .media-figure img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
  }

  .media-figure figcaption {
    margin-top: 0.5rem;
  }
</style>
