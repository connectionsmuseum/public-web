---
interface Props {
  /** Home destination for the shared, labelled return link. */
  homeHref?: string;
}
const { homeHref = "/" } = Astro.props;
---

<!-- Header and footer belong outside PageBody, which owns the main landmark. -->
<header class="header">
  <a id="title" href={homeHref} aria-label="Connections Museum — return home">
    <img id="logo" src="/cascades.svg" alt="" />
    <span>Connections Museum</span>
  </a>
</header>

<style>
  .header { width: 100%; padding-bottom: 1rem; }
  #title {
    display: flex;
    align-items: center;
    gap: 0.2em;
    font-size: clamp(1.5rem, 8vw, 10.5rem);
    line-height: 1;
    letter-spacing: -0.05em;
    white-space: nowrap;
  }
  #logo {
    flex: 0 0 1em;
    width: 1em;
    height: 1em;
    object-fit: contain;
    padding: 0;
    margin: 0;
  }
  @media (prefers-color-scheme: dark) { #logo { filter: invert(100%); } }
</style>
