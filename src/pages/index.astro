---
import ActionLink from "../components/content/ActionLink.astro";
import BannerCaption from "../components/content/BannerCaption.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Callout from "../components/content/Callout.astro";
import ClosureAnnouncement from "../components/content/ClosureAnnouncement.astro";
import ContactDetails from "../components/content/ContactDetails.astro";
import ContentGrid from "../components/structure/ContentGrid.astro";
import ContentSection from "../components/structure/ContentSection.astro";
import MobileOnlyContentSection from "../components/structure/MobileOnlyContentSection.astro";
import PageBody from "../components/structure/PageBody.astro";
import PageHeading from "../components/structure/PageHeading.astro";
import SiteHeader from "../components/structure/SiteHeader.astro";
import VideoLink from "../components/content/VideoLink.astro";
import bannerImage from "../../images/banners/cv_sarah_jkl.jpg";
import { seattleVisit } from "../data/seattleVisit";
---

<BaseLayout
  title="Connections Museum"
  description="Home to incredible exhibits of everything to do with telecommunications history, from working electromechanical relay telephone switches to modern electronic switching systems, station handsets, payphones, and more."
>
  <SiteHeader />
  <PageBody>
    <BannerCaption image={bannerImage} alt="Sarah Autumn working on step-by-step telephone switching equipment">
      Chief Engineer Sarah Autumn working on step-by-step
      equipment in the switchroom of the "JKL" American Museum of Telephony in
      Santa Cruz, California. Photograph by
      <a href="https://www.ultraviolet.gay">Claire Violet.</a>
    </BannerCaption>

    <PageHeading level="h1">Come visit us!</PageHeading>
    <ClosureAnnouncement message={seattleVisit.closureNotice ?? undefined} />
    <ContentGrid columns={4}>
      <MobileOnlyContentSection id="mobile-visit-notice" title="Visiting our Seattle museum?">
        <p><strong>Here's a few things you should know...</strong></p>
        <Callout>
          <p>
            We're open almost every {seattleVisit.hours.day} from {seattleVisit.hours.opensCompact} to {seattleVisit.hours.closesCompact}. The last tour starts
            at about {seattleVisit.hours.doorsCloseClock}. If you are really technical, or a big fan, you'll
            probably want to arrive before {seattleVisit.hours.arriveEarlyBy} to see everything.
          </p>
          <p>
            We're located at
            <ActionLink href={seattleVisit.location.mapsHref}>{seattleVisit.location.address}</ActionLink>.
          </p>
          <p>The suggested donation is {seattleVisit.suggestedDonation.adult} for adults.</p>
          <p>
            <ActionLink href="/seattle/visiting-info.html" marker="⌘">
              We have more detailed information for visitors with disabilities,
              or those arriving with large groups, children, and animals on our
              Seattle visiting information page.
            </ActionLink>
          </p>
          <p>Still have questions? Call us at <ActionLink href={`tel:${seattleVisit.contact.phone}`}>{seattleVisit.contact.phoneLabel}</ActionLink>.</p>
        </Callout>
      </MobileOnlyContentSection>

      <!-- Preserve the original reading order: two museum invitations,
           archives/contact, then support links. Keep related sections in one
           cell so they flow independently of the neighboring columns. -->
      <r-cell span="1" class="only-large-window">
        <ContentSection id="seattle-info" title="Seattle, Wash." headingLevel="h2">
          <p>
            <strong>Connections Museum Seattle</strong>, formerly the
            <i>Herbert H. Warrick Jr. Museum of Communications</i>, boasts an
            extensive collection of switching equipment, telephones, central
            office and outside plant equipment.<br />
            <i>Open most {seattleVisit.hours.days}, {seattleVisit.hours.opensCompact}–{seattleVisit.hours.closesCompact}.</i>
          </p>
          <p>
            Established in 1986 by former Bell System employees, this museum is
            the home of the only working Panel Switch, No. One Crossbar, and
            3ESS in the world. Switches and other equipment can be heard
            clicking and humming as they work to connect phones and other devices.
          </p>
          <ActionLink href="/seattle/visiting-info.html" prominence="feature" marker="⌘">
            Seattle Museum Hours, Directions, &amp; Tour Information
          </ActionLink>
          <p>
            If you live in or visit the Seattle area, come check out our
            one-of-a-kind museum, housed in an active telephone company Central
            Office and packed full of rare switching artifacts, familiar
            telephone sets and payphone booths, interactive displays, and aisles
            of working telecom equipment, all restored to incredible condition.
            Our most exciting equipment is the last example in the entire world,
            and you can try it out, exactly as it was back in 1923! Unless you
            worked for AT&amp;T or the Bell System during the middle of the last
            century, you've never seen anything quite like our museum. We have
            informative docents and passionate volunteers who are excited to
            show you around. We're just a short drive up the road from the Museum of Flight.
          </p>
          <hr />
          <p>
            We've acquired the collection of the
            <a href="https://www.jklmuseum.com">"JKL" American Museum of Telephony</a>.
            Remco Enthoven, who cared for it as JKL's curator, has joined us as
            Connections Museum curator. The collection has moved to Seattle,
            and we're preparing its new display gallery.
          </p>
          <p>
            <VideoLink href="https://youtu.be/iXMSm86jxaA?si=5-YijQ4iJTzdz9vf">
              Watch the JKL collection announcement
            </VideoLink>
          </p>
        </ContentSection>
      </r-cell>

      <r-cell span="1" class="only-large-window">
        <ContentSection id="denver-info" title="Denver, Colo." headingLevel="h2">
          <p>
            <strong>Connections Museum Denver</strong> is located in the historic
            931 14th Street building in Denver and includes the original executive
            offices and Allen Tupper True murals. <i>Tours are available by appointment.</i>
          </p>
          <ActionLink href="/denver.html#downtown" prominence="feature" marker="፠">About Our Denver Museum</ActionLink>
          <p>
            <strong>Connections Museum Colorado</strong> is currently under active
            construction of our new building, exhibits, and volunteer docent
            group. We hope to have the museum open soon! It will be located in
            Arvada, Colorado, walkable from RTD's 60th/Sheridan-Arvada Gold Strike Station.
          </p>
          <p>
            <VideoLink href="https://www.youtube.com/watch?v=RBXu7qJ7dNQ&list=PLm8mbrpAteNnJd5OOXEiONSqwawlf9nqo">
              Check out our YouTube video series to follow along as we set up!
            </VideoLink>
          </p>
          <p>
            The Arvada museum will contain complementary exhibits to the Seattle
            museum, such as a large step-by-step switch, a No. Three Crossbar,
            and a 5ESS, as well as a large collection of phones.
          </p>
          <p>
            If you live in the area and are passionate about telecommunications
            and mechanical technology, please <ActionLink href="/support.html#volunteer">sign up here</ActionLink>
            if you'd like to be one of our early volunteers helping build our new museum!
          </p>
          <p>
            Otherwise, please consider <ActionLink href="/support.html#donate">making a financial contribution</ActionLink>
            to show your support!
          </p>
        </ContentSection>
      </r-cell>

      <r-cell span="1" class="only-large-window">
        <ContentSection id="archives-info" title="Archives" headingLevel="h2">
          <p>
            The <strong>THG Archives</strong>, located in downtown Denver, contain
            telephone directories, over 100,000 photographs and slides, historic
            business records, and other items.
            <ActionLink href="/denver.html#archives">Research services are available from our staff or in person by visitors.</ActionLink>
          </p>
          <p>
            The Connections Museum Seattle operates a reference library of
            information related to our region and the equipment we maintain.
            <ActionLink href="/seattle/library.html">Contributions of materials greatly appreciated. Digitization of our technical documentation is available upon request.</ActionLink>
          </p>
        </ContentSection>
        <hr />
        <ContentSection id="contact" title="Contact Us" headingLevel="h2">
          <p>
            If you have an in-depth question about the function of our equipment
            or telecommunications history, please send us an email, as our
            volunteers often have limited time for calls during our open hours.
          </p>
          <ContactDetails
            name="Connections Museum Seattle"
            phone={seattleVisit.contact.phone}
            phoneLabel={seattleVisit.contact.phoneLabel}
            email={seattleVisit.contact.email}
          />
          <ContactDetails
            name="Connections Museum Denver & THG Archives"
            phone="+13032961221"
            phoneLabel="(303) 296–1221"
            email="denver@connections.museum"
            additionalEmails={["archives@connections.museum"]}
          />
          <p>Want to send us something? <ActionLink href="/support.html#mailing_address">Information about mailing donations.</ActionLink></p>
        </ContentSection>
      </r-cell>

      <r-cell span="1">
        <nav aria-label="Support and follow the museum">
          <ActionLink href="https://www.youtube.com/@ConnectionsMuseum" variant="callout" prominence="feature" marker="→">Subscribe to our YouTube channel!</ActionLink>
          <ActionLink href="https://tacobelllabs.net/@connections" variant="callout" prominence="feature" marker="→">Follow us on Mastodon too!</ActionLink>
          <hr />
          <ActionLink href="/support.html#donate" prominence="section">Donate</ActionLink>
          <p>
            The Connections Museum is a volunteer-driven organization. If you
            like what we do, please consider making a donation to help support
            us, or contributing your time to help make it happen.
          </p>
          <ActionLink href="https://cottonbureau.com/people/connections-museum" prominence="section" marker="→">Online Gift Shop</ActionLink>
          <ActionLink href="https://wiki.connections.museum" prominence="section">Wiki</ActionLink>
          <ActionLink href="/support.html#volunteer" prominence="section">Volunteer</ActionLink>
          <ActionLink href="/thg.html" prominence="section">About Us</ActionLink>
          <p>We are part of the Telecommunications History Group Inc., a 501(c)(3) non-profit organization.</p>
          <div class="only-small-window">
            <ActionLink href="/seattle.html" prominence="section">About Seattle</ActionLink>
            <ActionLink href="/denver.html" prominence="section">About Denver</ActionLink>
            <ActionLink href="/denver.html#archives" prominence="section">About Our Archives</ActionLink>
          </div>
        </nav>
        <hr />
        <p>
          Problem with our new website?<br />
          <ActionLink href="https://github.com/connectionsmuseum/public-web/issues">Let us know on GitHub!</ActionLink>
        </p>
      </r-cell>
    </ContentGrid>
  </PageBody>
</BaseLayout>
